<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xml:base="http://example.org/ontology/urban-science-teaching-model/"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:dcterms="http://purl.org/dc/terms/"
    xmlns:ont="http://example.org/ontology/urban-science-teaching-model/"
    xmlns:opmeta="https://microsoft.github.io/Ontology-Playground/ns/metadata#"
>

    <owl:Ontology rdf:about="http://example.org/ontology/urban-science-teaching-model/">
        <rdfs:label>Urban Science Teaching Model</rdfs:label>
        <rdfs:comment>城市科学本体教学模型：八个节点表示类型及其属性定义，以虚构的旧校舍转作公共图书馆说明对象、用途、组织、事件与观测。模型用于概念设计，未连接实例数据库。</rdfs:comment>
    </owl:Ontology>

    <!-- Ontology Playground metadata vocabulary -->
    <rdfs:Class rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#DataBinding">
        <rdfs:label>Ontology Playground data binding</rdfs:label>
    </rdfs:Class>
    <owl:AnnotationProperty rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#icon">
        <rdfs:label>icon</rdfs:label>
        <rdfs:comment>Presentation icon for an entity type.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#color">
        <rdfs:label>color</rdfs:label>
        <rdfs:comment>Presentation color for an entity type.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#isIdentifier">
        <rdfs:label>isIdentifier</rdfs:label>
        <rdfs:comment>Whether an entity property is used as its Playground identifier.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#unit">
        <rdfs:label>unit</rdfs:label>
        <rdfs:comment>Display unit associated with a numeric property.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#enumValues">
        <rdfs:label>enumValues</rdfs:label>
        <rdfs:comment>Comma-delimited enum values used only by Playground round trips.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#propertyType">
        <rdfs:label>propertyType</rdfs:label>
        <rdfs:comment>Playground property type: string, integer, decimal, double, date, datetime, boolean, or enum.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#cardinality">
        <rdfs:label>cardinality</rdfs:label>
        <rdfs:comment>Playground relationship multiplicity: one-to-one, one-to-many, many-to-one, or many-to-many.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#fromEntityId">
        <rdfs:label>fromEntityId</rdfs:label>
        <rdfs:comment>Playground ID of a relationship source entity.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#toEntityId">
        <rdfs:label>toEntityId</rdfs:label>
        <rdfs:comment>Playground ID of a relationship target entity.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#relationshipAttributeOf">
        <rdfs:label>relationshipAttributeOf</rdfs:label>
        <rdfs:comment>Playground ID of the relationship described by an attribute.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#attributeType">
        <rdfs:label>attributeType</rdfs:label>
        <rdfs:comment>Playground relationship attribute type: string, integer, decimal, double, date, datetime, boolean, or enum.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#generatedSubset">
        <rdfs:label>generatedSubset</rdfs:label>
        <rdfs:comment>Whether this RDF document was generated from the Playground visual model.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#sourceVersionIri">
        <rdfs:label>sourceVersionIri</rdfs:label>
        <rdfs:comment>Version IRI of the source ontology represented by the visual model.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#sourceVersionInfo">
        <rdfs:label>sourceVersionInfo</rdfs:label>
        <rdfs:comment>Version label of the source ontology represented by the visual model.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#sourceImport">
        <rdfs:label>sourceImport</rdfs:label>
        <rdfs:comment>Import IRI recorded from the source ontology without dereferencing it.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#boundClass">
        <rdfs:label>boundClass</rdfs:label>
        <rdfs:comment>Domain class targeted by a Playground data binding.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#boundEntityId">
        <rdfs:label>boundEntityId</rdfs:label>
        <rdfs:comment>Playground entity ID targeted by a data binding.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#source">
        <rdfs:label>source</rdfs:label>
        <rdfs:comment>Source name retained by a Playground data binding.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#table">
        <rdfs:label>table</rdfs:label>
        <rdfs:comment>Table name retained by a Playground data binding.</rdfs:comment>
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="https://microsoft.github.io/Ontology-Playground/ns/metadata#columnMapping">
        <rdfs:label>columnMapping</rdfs:label>
        <rdfs:comment>Property-to-column mapping retained by a Playground data binding.</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- Entity Types (Classes) -->
    <owl:Class rdf:about="http://example.org/ontology/urban-science-teaching-model/Building">
        <rdfs:label>Building</rdfs:label>
        <rdfs:comment>建筑：具有持续身份的物理对象。用途改变时，是否保持同一建筑标识需要另行约定；本模型不把建筑与运营机构合并。</rdfs:comment>
        <opmeta:icon>🏛️</opmeta:icon>
        <opmeta:color>#1764A0</opmeta:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/urban-science-teaching-model/Organisation">
        <rdfs:label>Organisation</rdfs:label>
        <rdfs:comment>组织：承担服务运营等职责的组织，与其使用的物理建筑分别识别。</rdfs:comment>
        <opmeta:icon>🏢</opmeta:icon>
        <opmeta:color>#087F8C</opmeta:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/urban-science-teaching-model/Service">
        <rdfs:label>Service</rdfs:label>
        <rdfs:comment>服务：如借阅服务、阅览服务及其安排；与一次具体借阅活动区分。一个服务可在多个地点提供，一个建筑也可承载多项服务。</rdfs:comment>
        <opmeta:icon>📚</opmeta:icon>
        <opmeta:color>#28733D</opmeta:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/urban-science-teaching-model/UseAssignment">
        <rdfs:label>UseAssignment</rdfs:label>
        <rdfs:comment>用途分配：把建筑、用途和有效时段联系起来。结束时间缺省需结合endStatus解释，不自动意味着仍有效。</rdfs:comment>
        <opmeta:icon>🏷️</opmeta:icon>
        <opmeta:color>#A36500</opmeta:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/urban-science-teaching-model/Event">
        <rdfs:label>Event</rdfs:label>
        <rdfs:comment>事件：改造、批准、启用或停用等发生项。事件与支持事件判断的文档分别表示。</rdfs:comment>
        <opmeta:icon>📅</opmeta:icon>
        <opmeta:color>#B74432</opmeta:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/urban-science-teaching-model/UrbanArea">
        <rdfs:label>UrbanArea</rdfs:label>
        <rdfs:comment>城市范围：按行政、形态或功能规则确定的空间范围。一个建筑允许关联多套范围；比较统计量时保留定义与边界版本。</rdfs:comment>
        <opmeta:icon>🗺️</opmeta:icon>
        <opmeta:color>#7142A8</opmeta:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/urban-science-teaching-model/Observation">
        <rdfs:label>Observation</rdfs:label>
        <rdfs:comment>观测：本图限定建筑层级的属性或汇总观测。房间温度需扩展房间类型并指定对象；观测与承载结果的记录分别识别。</rdfs:comment>
        <opmeta:icon>📏</opmeta:icon>
        <opmeta:color>#006B91</opmeta:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/urban-science-teaching-model/EvidenceRecord">
        <rdfs:label>EvidenceRecord</rdfs:label>
        <rdfs:comment>证据记录：支持用途、事件或观测判断的文档和来源。记录存在与判断已经证实分别说明。</rdfs:comment>
        <opmeta:icon>📄</opmeta:icon>
        <opmeta:color>#5C6470</opmeta:color>
    </owl:Class>

    <!-- Data Properties -->
    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/building_buildingId">
        <rdfs:label>buildingId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Building"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>建筑标识的字段定义；不包含任何真实标识值。</rdfs:comment>
        <opmeta:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</opmeta:isIdentifier>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/building_name">
        <rdfs:label>name</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Building"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>建筑名称。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/building_lifecycleStatus">
        <rdfs:label>lifecycleStatus</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Building"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>建筑生命周期状态。</rdfs:comment>
        <opmeta:enumValues>existing,altered,demolished,unknown</opmeta:enumValues>
        <opmeta:propertyType>enum</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/building_geometryReference">
        <rdfs:label>geometryReference</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Building"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>指向几何表达的引用；当前没有坐标或几何实例。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/building_crs">
        <rdfs:label>crs</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Building"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>几何所用坐标参考系。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/organisation_organisationId">
        <rdfs:label>organisationId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Organisation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>组织标识字段。</rdfs:comment>
        <opmeta:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</opmeta:isIdentifier>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/organisation_name">
        <rdfs:label>name</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Organisation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>组织名称。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/organisation_organisationType">
        <rdfs:label>organisationType</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Organisation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>组织类型及其判定口径。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/service_serviceId">
        <rdfs:label>serviceId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>服务标识字段。</rdfs:comment>
        <opmeta:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</opmeta:isIdentifier>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/service_name">
        <rdfs:label>name</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>服务名称。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/service_serviceKind">
        <rdfs:label>serviceKind</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>服务类别及定义。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/service_openingSchedule">
        <rdfs:label>openingSchedule</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>开放安排，需包括日期与例外说明。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/service_timeZone">
        <rdfs:label>timeZone</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>开放安排采用的时区。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/service_accessRule">
        <rdfs:label>accessRule</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>服务的使用条件与规则依据。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/useAssignment_assignmentId">
        <rdfs:label>assignmentId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/UseAssignment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>用途分配标识字段。</rdfs:comment>
        <opmeta:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</opmeta:isIdentifier>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/useAssignment_useName">
        <rdfs:label>useName</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/UseAssignment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>用途名称；例如校舍或公共图书馆仅是教学情境。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/useAssignment_validFrom">
        <rdfs:label>validFrom</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/UseAssignment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>用途开始生效的时刻。</rdfs:comment>
        <opmeta:propertyType>datetime</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/useAssignment_validTo">
        <rdfs:label>validTo</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/UseAssignment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>用途结束生效的时刻，可尚未登记。</rdfs:comment>
        <opmeta:propertyType>datetime</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/useAssignment_endStatus">
        <rdfs:label>endStatus</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/UseAssignment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>明确区分持续、已结束与未知。</rdfs:comment>
        <opmeta:enumValues>ongoing,ended,unknown</opmeta:enumValues>
        <opmeta:propertyType>enum</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/useAssignment_assertionStatus">
        <rdfs:label>assertionStatus</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/UseAssignment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>用途判断的证据状态。</rdfs:comment>
        <opmeta:enumValues>reported,verified,disputed,unknown</opmeta:enumValues>
        <opmeta:propertyType>enum</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/event_eventId">
        <rdfs:label>eventId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>事件标识字段。</rdfs:comment>
        <opmeta:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</opmeta:isIdentifier>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/event_eventType">
        <rdfs:label>eventType</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>事件类型及判定条件。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/event_startsAt">
        <rdfs:label>startsAt</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>事件开始时刻。</rdfs:comment>
        <opmeta:propertyType>datetime</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/event_endsAt">
        <rdfs:label>endsAt</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>事件结束时刻。</rdfs:comment>
        <opmeta:propertyType>datetime</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/event_description">
        <rdfs:label>description</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>事件说明及适用范围。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/urbanArea_areaId">
        <rdfs:label>areaId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/UrbanArea"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>空间范围标识字段。</rdfs:comment>
        <opmeta:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</opmeta:isIdentifier>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/urbanArea_name">
        <rdfs:label>name</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/UrbanArea"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>范围名称。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/urbanArea_definitionType">
        <rdfs:label>definitionType</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/UrbanArea"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>行政、形态或功能界定。</rdfs:comment>
        <opmeta:enumValues>administrative,morphological,functional</opmeta:enumValues>
        <opmeta:propertyType>enum</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/urbanArea_definitionMethod">
        <rdfs:label>definitionMethod</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/UrbanArea"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>界定规则及数据来源。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/urbanArea_boundaryVersion">
        <rdfs:label>boundaryVersion</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/UrbanArea"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>边界版本与时期。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/urbanArea_validFrom">
        <rdfs:label>validFrom</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/UrbanArea"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>该版本的适用起点。</rdfs:comment>
        <opmeta:propertyType>datetime</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/urbanArea_validTo">
        <rdfs:label>validTo</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/UrbanArea"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>该版本的适用终点，未知需明确标注。</rdfs:comment>
        <opmeta:propertyType>datetime</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/urbanArea_geometryReference">
        <rdfs:label>geometryReference</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/UrbanArea"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>边界几何引用；当前没有真实边界数据。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/observation_observationId">
        <rdfs:label>observationId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>观测标识字段。</rdfs:comment>
        <opmeta:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</opmeta:isIdentifier>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/observation_observedProperty">
        <rdfs:label>observedProperty</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>被观测属性与统计口径。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/observation_procedure">
        <rdfs:label>procedure</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>采集、抽样或计算方法。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/observation_resultValue">
        <rdfs:label>resultValue</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>结果的文本表示；进行数值计算前还需类型与单位检查。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/observation_unit">
        <rdfs:label>unit</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>结果单位及计数口径。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/observation_phenomenonTime">
        <rdfs:label>phenomenonTime</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>被观测现象的时间。</rdfs:comment>
        <opmeta:propertyType>datetime</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/observation_resultTime">
        <rdfs:label>resultTime</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>结果形成或登记的时间。</rdfs:comment>
        <opmeta:propertyType>datetime</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/observation_targetScope">
        <rdfs:label>targetScope</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>明确对象层级、覆盖与聚合范围。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/evidenceRecord_recordId">
        <rdfs:label>recordId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/EvidenceRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>记录标识字段。</rdfs:comment>
        <opmeta:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</opmeta:isIdentifier>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/evidenceRecord_recordType">
        <rdfs:label>recordType</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/EvidenceRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>档案、公告或测量记录等类型。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/evidenceRecord_sourceTitle">
        <rdfs:label>sourceTitle</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/EvidenceRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>来源标题。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/evidenceRecord_sourceURI">
        <rdfs:label>sourceURI</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/EvidenceRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>可追溯来源的地址字段；当前不包含真实记录地址。</rdfs:comment>
        <opmeta:propertyType>string</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/evidenceRecord_issuedAt">
        <rdfs:label>issuedAt</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/EvidenceRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>发布或形成时间。</rdfs:comment>
        <opmeta:propertyType>datetime</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/evidenceRecord_accessedAt">
        <rdfs:label>accessedAt</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/EvidenceRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>查阅时间。</rdfs:comment>
        <opmeta:propertyType>datetime</opmeta:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/evidenceRecord_status">
        <rdfs:label>status</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/EvidenceRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>记录版本与可用状态。</rdfs:comment>
        <opmeta:enumValues>available,superseded,disputed,unknown</opmeta:enumValues>
        <opmeta:propertyType>enum</opmeta:propertyType>
    </owl:DatatypeProperty>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/organisation_operates_service">
        <rdfs:label>运营</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Organisation"/>
        <rdfs:range rdf:resource="http://example.org/ontology/urban-science-teaching-model/Service"/>
        <rdfs:comment>组织在有效时段内运营服务。关系属性validFrom、validTo、endStatus说明时间条件；缺省结束时刻需要解释。</rdfs:comment>
        <opmeta:cardinality>many-to-many</opmeta:cardinality>
        <opmeta:fromEntityId>organisation</opmeta:fromEntityId>
        <opmeta:toEntityId>service</opmeta:toEntityId>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/organisation_operates_service_validFrom">
        <rdfs:label>validFrom</rdfs:label>
        <rdfs:comment>Relationship attribute for 运营</rdfs:comment>
        <opmeta:relationshipAttributeOf>organisation_operates_service</opmeta:relationshipAttributeOf>
        <opmeta:attributeType>datetime</opmeta:attributeType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/organisation_operates_service_validTo">
        <rdfs:label>validTo</rdfs:label>
        <rdfs:comment>Relationship attribute for 运营</rdfs:comment>
        <opmeta:relationshipAttributeOf>organisation_operates_service</opmeta:relationshipAttributeOf>
        <opmeta:attributeType>datetime</opmeta:attributeType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/organisation_operates_service_endStatus">
        <rdfs:label>endStatus</rdfs:label>
        <rdfs:comment>Relationship attribute for 运营</rdfs:comment>
        <opmeta:relationshipAttributeOf>organisation_operates_service</opmeta:relationshipAttributeOf>
        <opmeta:attributeType>string</opmeta:attributeType>
    </owl:DatatypeProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/service_provided_at_building">
        <rdfs:label>提供地点</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Service"/>
        <rdfs:range rdf:resource="http://example.org/ontology/urban-science-teaching-model/Building"/>
        <rdfs:comment>服务在建筑中提供；允许一项服务有多个地点及一栋建筑提供多项服务。</rdfs:comment>
        <opmeta:cardinality>many-to-many</opmeta:cardinality>
        <opmeta:fromEntityId>service</opmeta:fromEntityId>
        <opmeta:toEntityId>building</opmeta:toEntityId>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/service_provided_at_building_validFrom">
        <rdfs:label>validFrom</rdfs:label>
        <rdfs:comment>Relationship attribute for 提供地点</rdfs:comment>
        <opmeta:relationshipAttributeOf>service_provided_at_building</opmeta:relationshipAttributeOf>
        <opmeta:attributeType>datetime</opmeta:attributeType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/service_provided_at_building_validTo">
        <rdfs:label>validTo</rdfs:label>
        <rdfs:comment>Relationship attribute for 提供地点</rdfs:comment>
        <opmeta:relationshipAttributeOf>service_provided_at_building</opmeta:relationshipAttributeOf>
        <opmeta:attributeType>datetime</opmeta:attributeType>
    </owl:DatatypeProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/use_applies_to_building">
        <rdfs:label>用途对应建筑</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/UseAssignment"/>
        <rdfs:range rdf:resource="http://example.org/ontology/urban-science-teaching-model/Building"/>
        <rdfs:comment>每条用途分配预期针对一个建筑；many-to-one只表达最大数量方向，必填性需另行验证。</rdfs:comment>
        <opmeta:cardinality>many-to-one</opmeta:cardinality>
        <opmeta:fromEntityId>useAssignment</opmeta:fromEntityId>
        <opmeta:toEntityId>building</opmeta:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/use_supported_by_record">
        <rdfs:label>用途证据来源</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/UseAssignment"/>
        <rdfs:range rdf:resource="http://example.org/ontology/urban-science-teaching-model/EvidenceRecord"/>
        <rdfs:comment>将用途分配与支持该判断的证据记录关联。此关系与事件证据关系使用不同标识。</rdfs:comment>
        <opmeta:cardinality>many-to-many</opmeta:cardinality>
        <opmeta:fromEntityId>useAssignment</opmeta:fromEntityId>
        <opmeta:toEntityId>evidenceRecord</opmeta:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/building_located_in_area">
        <rdfs:label>位于范围内</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Building"/>
        <rdfs:range rdf:resource="http://example.org/ontology/urban-science-teaching-model/UrbanArea"/>
        <rdfs:comment>允许同一建筑对应行政、形态、功能等多套范围。范围的定义、边界版本与适用期由UrbanArea记录。</rdfs:comment>
        <opmeta:cardinality>many-to-many</opmeta:cardinality>
        <opmeta:fromEntityId>building</opmeta:fromEntityId>
        <opmeta:toEntityId>urbanArea</opmeta:toEntityId>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/building_located_in_area_asOf">
        <rdfs:label>asOf</rdfs:label>
        <rdfs:comment>Relationship attribute for 位于范围内</rdfs:comment>
        <opmeta:relationshipAttributeOf>building_located_in_area</opmeta:relationshipAttributeOf>
        <opmeta:attributeType>datetime</opmeta:attributeType>
    </owl:DatatypeProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/event_affects_building">
        <rdfs:label>事件涉及建筑</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Event"/>
        <rdfs:range rdf:resource="http://example.org/ontology/urban-science-teaching-model/Building"/>
        <rdfs:comment>事件与其涉及的建筑相联系；这条边不自动表达因果识别结论。</rdfs:comment>
        <opmeta:cardinality>many-to-many</opmeta:cardinality>
        <opmeta:fromEntityId>event</opmeta:fromEntityId>
        <opmeta:toEntityId>building</opmeta:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/event_establishes_use">
        <rdfs:label>对应用途变更</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Event"/>
        <rdfs:range rdf:resource="http://example.org/ontology/urban-science-teaching-model/UseAssignment"/>
        <rdfs:comment>在有证据时，将改造或启用事件与相应的用途分配关联。</rdfs:comment>
        <opmeta:cardinality>many-to-many</opmeta:cardinality>
        <opmeta:fromEntityId>event</opmeta:fromEntityId>
        <opmeta:toEntityId>useAssignment</opmeta:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/event_supported_by_record">
        <rdfs:label>事件证据来源</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Event"/>
        <rdfs:range rdf:resource="http://example.org/ontology/urban-science-teaching-model/EvidenceRecord"/>
        <rdfs:comment>将事件判断与证据记录关联，与用途证据关系分别建模。</rdfs:comment>
        <opmeta:cardinality>many-to-many</opmeta:cardinality>
        <opmeta:fromEntityId>event</opmeta:fromEntityId>
        <opmeta:toEntityId>evidenceRecord</opmeta:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/observation_observes_building">
        <rdfs:label>观测建筑</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Observation"/>
        <rdfs:range rdf:resource="http://example.org/ontology/urban-science-teaching-model/Building"/>
        <rdfs:comment>本练习限定一条观测针对一栋建筑的属性或汇总指标；观测时间、方法、结果与单位由Observation记录。</rdfs:comment>
        <opmeta:cardinality>many-to-one</opmeta:cardinality>
        <opmeta:fromEntityId>observation</opmeta:fromEntityId>
        <opmeta:toEntityId>building</opmeta:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/urban-science-teaching-model/observation_documented_by_record">
        <rdfs:label>观测记录来源</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/urban-science-teaching-model/Observation"/>
        <rdfs:range rdf:resource="http://example.org/ontology/urban-science-teaching-model/EvidenceRecord"/>
        <rdfs:comment>区分观测过程／结果与承载它们的文档记录；记录数量不等同人数或活动次数。</rdfs:comment>
        <opmeta:cardinality>many-to-many</opmeta:cardinality>
        <opmeta:fromEntityId>observation</opmeta:fromEntityId>
        <opmeta:toEntityId>evidenceRecord</opmeta:toEntityId>
    </owl:ObjectProperty>

</rdf:RDF>
